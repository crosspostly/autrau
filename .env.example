# Autrau — environment variables

# Server
AUTRAU_HOST=127.0.0.1
AUTRAU_PORT=8000
MAX_UPLOAD_MB=500

# Default active transcription. The UI can override these.
# Provider: faster-whisper | whisper-cpp | parakeet
AUTRAU_PROVIDER=faster-whisper
# Model (depends on provider): tiny | base | small | medium | large-v3
AUTRAU_MODEL=small
# Device: cpu | cuda
AUTRAU_DEVICE=cpu

# Skip the startup update check
AUTRAU_SKIP_UPDATE_CHECK=0

# Model cache locations (HF uses these; model dirs are provider-specific)
# HF_HOME=%USERPROFILE%\.cache\huggingface
